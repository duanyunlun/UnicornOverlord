<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnicornOverlord"
        x:Class="UnicornOverlord.MainWindow"
        x:Name="Root"
        mc:Ignorable="d"
        Title="独角兽之王 存档与 MOD 编辑器"
        Width="1180" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsFileCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <local:ClassIDConverter x:Key="ClassIDConverter" />
    <local:ItemIDConverter x:Key="ItemIDConverter" />
    <local:NameIDConverter x:Key="NameIDConverter" />
    <SolidColorBrush x:Key="AccentBrush" Color="#287764" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5F2EE" />
    <SolidColorBrush x:Key="SaveAccentBrush" Color="#315F78" />
    <SolidColorBrush x:Key="SaveSoftBrush" Color="#E7F0F5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DBE0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#656B75" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.option-title">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.header">
      <Setter Property="Background" Value="#35414C" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#7D8994" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.header:pointerover">
      <Setter Property="Background" Value="#4A5865" />
    </Style>
    <Style Selector="Button.header:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBox.editor">
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="ShowButtonSpinner" Value="False" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="ScrollViewer.AllowAutoHide" Value="True" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ScrollBar[AllowAutoHide=True][IsExpanded=False] /template/ Thumb">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="TabItem.workspace">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="MinWidth" Value="148" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#E4E7EA" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TabItem.workspace-save:selected">
      <Setter Property="Background" Value="{StaticResource SaveSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource SaveAccentBrush}" />
    </Style>
    <Style Selector="TabItem.workspace-mod:selected">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TabItem.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Border Grid.Row="0" Background="#20252B" Padding="24,16">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Spacing="2">
          <TextBlock Text="独角兽之王" FontSize="22" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="Nintendo Switch 存档与 MOD 编辑器" Foreground="#BFC6CE" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsModWorkspace}">
          <TextBlock Classes="option-title" Text="目标版本" Foreground="#D7DCE1" VerticalAlignment="Center" />
            <ComboBox Width="168" ItemsSource="{Binding ModTargets}" SelectedItem="{Binding ActiveModTarget, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <TextBlock Classes="option-title" Text="编辑器语言" Foreground="#D7DCE1" ToolTip.Tip="切换技能、职业、物品等游戏数据名称的显示语言" VerticalAlignment="Center" />
          <ComboBox Width="120" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="12,8,12,0" SelectedIndex="{Binding WorkspaceIndex, Mode=TwoWay}">
      <TabItem Classes="workspace workspace-save" Header="存档编辑">
        <Border Background="#F1F6F8" Padding="10,6,10,0">
          <TabControl>
      <TabItem Classes="section" Header="概览">
        <Border Classes="panel" Padding="24" Margin="0,12,0,0">
          <StackPanel Spacing="20" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel Spacing="3">
              <TextBlock Classes="section-title" Text="游戏进度" />
              <TextBlock Classes="caption" Text="当前存档的主要进度数值" />
            </StackPanel>
            <Grid ColumnDefinitions="180,220" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
              <TextBlock Classes="option-title" Text="金币" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Classes="editor" Text="{Binding Basic.Money, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Classes="option-title" Text="名望" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Classes="editor" Text="{Binding Basic.Fame, Mode=TwoWay}" />
              <TextBlock Grid.Row="2" Classes="option-title" Text="泽诺伊拉难度" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Basic.ZENOIRA, Mode=TwoWay}" OnContent="启用" OffContent="停用" />
            </Grid>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Classes="section" Header="角色">
        <Grid ColumnDefinitions="260,*,300" ColumnSpacing="12" Margin="0,12,0,0">
          <Border Classes="panel">
            <Grid RowDefinitions="Auto,*,Auto">
              <StackPanel Margin="16" Spacing="3">
                <TextBlock Classes="section-title" Text="角色列表" />
                <TextBlock Classes="caption" Text="{Binding Characters.Count, StringFormat='{}{0} 名角色'}" />
              </StackPanel>
              <ListBox Grid.Row="1" x:Name="CharacterList" ItemsSource="{Binding Characters}"
                       SelectedIndex="{Binding SelectedCharacterIndex, Mode=TwoWay}"
                       BorderThickness="0,1,0,1" BorderBrush="{StaticResource BorderBrush}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name, Converter={StaticResource NameIDConverter}}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18" Margin="10" HorizontalAlignment="Center">
                <Button Classes="compact" Content="导出" ToolTip.Tip="将当前角色保存为 .uocd 文件"
                        Command="{Binding ExportCharacterCommand}" CommandParameter="{Binding SelectedIndex, ElementName=CharacterList}" />
                <Button Classes="compact" Content="替换" ToolTip.Tip="用 .uocd 文件替换当前角色，保留当前角色 ID"
                        Command="{Binding ImportCharacterCommand}" CommandParameter="{Binding SelectedIndex, ElementName=CharacterList}" />
                <Button Classes="compact" Content="新增" ToolTip.Tip="从一个或多个 .uocd 文件新增角色"
                        Command="{Binding InsertCharacterCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel" Padding="18,18,8,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True" Padding="0,0,14,0">
              <StackPanel Spacing="14">
                <TextBlock Classes="section-title" Text="角色属性" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                  <TextBlock Classes="option-title" Text="启用" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SelectedItem.Use, ElementName=CharacterList, Mode=TwoWay}" OnContent="启用" OffContent="停用" />
                  <TextBlock Grid.Row="1" Classes="option-title" Text="职业" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="compact" Content="更换" Command="{Binding ChoiceClassCommand}" CommandParameter="{Binding SelectedItem, ElementName=CharacterList}" />
                    <TextBlock Text="{Binding SelectedItem.Class, ElementName=CharacterList, Converter={StaticResource ClassIDConverter}}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                  <StackPanel Spacing="4"><TextBlock Classes="option-title" Text="等级"/><TextBox Classes="editor" Text="{Binding SelectedItem.Lv, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="option-title" Text="经验值"/><TextBox Classes="editor" Text="{Binding SelectedItem.Exp, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4"><TextBlock Classes="option-title" Text="生命加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.HPPlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="1" Spacing="4"><TextBlock Classes="option-title" Text="物理攻击加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.AttackPlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Classes="option-title" Text="物理防御加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.DefensePlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Classes="option-title" Text="魔法攻击加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.MagicAttackPlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="2" Spacing="4"><TextBlock Classes="option-title" Text="魔法防御加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.MagicDefensePlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Classes="option-title" Text="命中加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.HitRatePlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4"><TextBlock Classes="option-title" Text="闪避加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.AVoidPlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="3" Spacing="4"><TextBlock Classes="option-title" Text="暴击率加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.CriticalPlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4"><TextBlock Classes="option-title" Text="格挡率加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.GuardPlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="2" Spacing="4"><TextBlock Classes="option-title" Text="行动速度加成"/><TextBox Classes="editor" Text="{Binding SelectedItem.SpeedPlus, ElementName=CharacterList, Mode=TwoWay}"/></StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Grid.Column="2" Classes="panel">
            <Grid RowDefinitions="Auto,Auto,*">
              <StackPanel Margin="16,16,16,8" Spacing="3">
                <TextBlock Classes="section-title" Text="亲密度" />
                <TextBlock Classes="caption" Text="角色之间的亲密度数值" />
              </StackPanel>
              <Button Grid.Row="1" Classes="compact" Content="全部设为 1000" HorizontalAlignment="Left" Margin="16,4,16,12"
                      Command="{Binding ChangeCharacterBondMaxCommand}" CommandParameter="{Binding SelectedItem, ElementName=CharacterList}" />
              <ListBox Grid.Row="2" ItemsSource="{Binding SelectedItem.Bonds, ElementName=CharacterList}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="0,0,8,0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,90" ColumnSpacing="10">
                      <TextBlock Text="{Binding NameID, Converter={StaticResource NameIDConverter}, ConverterParameter={Binding}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Classes="section" Header="物品">
        <Border Classes="panel" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="18,14">
              <StackPanel Spacing="2">
                <TextBlock Classes="section-title" Text="消耗品与材料" />
                <TextBlock Classes="caption" Text="{Binding InventorySummary}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="compact" Content="全消耗道具" ToolTip.Tip="补齐非剧情关键的消耗品、素材和礼物，每种数量为 1"
                        Command="{Binding AppendAllItemsCommand}" />
                <TextBlock Classes="option-title" Text="数量全部设为" VerticalAlignment="Center" />
                <NumericUpDown Width="110" Minimum="1" Maximum="999" Increment="1" FormatString="0"
                               Value="{Binding ItemCountTarget, Mode=TwoWay}" />
                <Button Classes="compact" Content="应用" Command="{Binding ChangeItemCountMaxCommand}" />
                <Button Classes="primary" Content="添加物品" Command="{Binding AppendItemCommand}" />
              </StackPanel>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Items}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,110,100" ColumnSpacing="12">
                    <TextBlock Text="{Binding ID, Converter={StaticResource ItemIDConverter}}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Minimum="1" Maximum="999" Increment="1" FormatString="0"
                                   Value="{Binding Count, Mode=TwoWay}" />
                    <Button Grid.Column="2" Classes="compact" Content="替换" Command="{Binding $parent[Window].DataContext.ChoiceItemCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>

      <TabItem Classes="section" Header="装备">
        <Border Classes="panel" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="18,14">
              <StackPanel Spacing="2">
                <TextBlock Classes="section-title" Text="装备列表" />
                <TextBlock Classes="caption" Text="{Binding InventorySummary}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="compact" Content="一键添加所有装备" ToolTip.Tip="为每种当前没有的装备添加一条记录"
                        Command="{Binding AppendAllEquipmentCommand}" />
                <Button Classes="primary" Content="添加装备" Command="{Binding AppendEquipmentCommand}" />
              </StackPanel>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Equipments}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,90,90,100" ColumnSpacing="12">
                    <TextBlock Text="{Binding ID, Converter={StaticResource ItemIDConverter}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Equipment1, StringFormat='参数 A：{0}'}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Equipment2, StringFormat='参数 B：{0}'}" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Classes="compact" Content="替换" Command="{Binding $parent[Window].DataContext.ChoiceEquipmentCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>

      <TabItem Classes="section" Header="编队">
        <Border Classes="panel" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Margin="18,14" Spacing="2">
              <TextBlock Classes="section-title" Text="部队编成" />
              <TextBlock Classes="caption" Text="十个已保存的编队槽位" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Units}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,130,120" ColumnSpacing="16">
                    <TextBlock Text="编队" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Valid, Mode=TwoWay}" OnContent="启用" OffContent="停用" />
                    <NumericUpDown Grid.Column="2" Value="{Binding Count, Mode=TwoWay}" Minimum="1" Maximum="6" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </TabItem>
		  </TabControl>
		</Border>
	  </TabItem>

	      <TabItem Classes="workspace workspace-mod" Header="MOD 制作">
			<Border Background="#F0F6F4" Padding="10,6,10,0">
	        <Border Classes="panel" Margin="0,8,0,0">
	          <Grid ColumnDefinitions="170,*">
              <ListBox ItemsSource="{Binding ModCategories}" SelectedItem="{Binding SelectedModCategory, Mode=TwoWay}"
                       BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="MinHeight" Value="40" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate>
	                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

	              <ScrollViewer Grid.Column="1" IsVisible="{Binding IsGameplayModWorkspace}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True" Padding="0,0,12,0">
	                <ItemsControl Margin="24,18" ItemsSource="{Binding SelectedModCategory.Modules}">
	                  <ItemsControl.ItemTemplate>
	                    <DataTemplate>
	                <StackPanel>
	                <StackPanel Spacing="10">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <TextBlock Classes="section-title" Text="{Binding Name}" VerticalAlignment="Center" />
                      <ToggleSwitch IsVisible="{Binding ShowHeaderEnableToggle}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    OnContent="" OffContent="" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    <TextBlock Foreground="#A24A37" FontSize="12" Text="{Binding Warning}" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsAbilityEditor}" Spacing="10">
                    <StackPanel Width="160" HorizontalAlignment="Left" Spacing="5">
                      <TextBlock Classes="option-title" Text="技能筛选"/>
                      <ComboBox Height="40" ItemsSource="{Binding AbilityFilters}" SelectedIndex="{Binding AbilityFilterIndex, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="5">
                      <TextBlock Classes="option-title" Text="技能"/>
                      <local:ModSearchPicker ItemsSource="{Binding FilteredSkillChoices}" SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="AP / PP 消耗"/><NumericUpDown Value="{Binding ValueA}" Minimum="0" Maximum="10"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="命中"/><NumericUpDown Value="{Binding ValueB}" Minimum="0" Maximum="999"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="目标范围"/><ComboBox ItemsSource="{Binding TargetShapes}" SelectedItem="{Binding SelectedTargetShape, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="物理威力"/><NumericUpDown Value="{Binding ValueD}" Minimum="0" Maximum="9999" Increment="1"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="魔法威力"/><NumericUpDown Value="{Binding ValueE}" Minimum="0" Maximum="9999" Increment="1"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="首个效果参数"/><NumericUpDown Value="{Binding ValueF}" Minimum="-9999" Maximum="9999" Increment="1"/></StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" Margin="0,20,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="option-title" FontSize="16" Text="固有类型" VerticalAlignment="Center"/>
                        <TextBlock FontSize="16" Text="主动技能（AP）" Foreground="#D97706" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsActiveAbility}"/>
                        <TextBlock FontSize="16" Text="被动技能（PP）" Foreground="#0891B2" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsPassiveAbility}"/>
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="option-title" Text="技能说明"/>
                        <TextBlock Classes="caption" FontSize="16" LineHeight="24" Text="{Binding AbilityDescription}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsBattlePreview}" Spacing="5">
                    <TextBlock Classes="option-title" Text="预览模式"/><ComboBox ItemsSource="{Binding PreviewModes}" SelectedIndex="{Binding RecordId}"/>
                    <TextBlock Classes="caption" Text="{Binding PreviewModeDescription}" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsCharacterRandomizer}" Spacing="8">
                    <TextBlock Classes="option-title" Text="随机种子"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <NumericUpDown Value="{Binding ValueA}" Minimum="1" Maximum="2147483647"/>
                      <Button Grid.Column="1" Classes="compact" Content="重新随机" Command="{Binding RerollCommand}"/>
                    </Grid>
                    <ToggleSwitch IsChecked="{Binding MixPromotionTiers, Mode=TwoWay}" OnContent="混合转职阶段" OffContent="保持相同转职阶段" HorizontalAlignment="Left"/>
                    <TextBlock Classes="caption" Text="默认只在相同转职阶段内交换；启用后允许基础、转职及后期角色跨阶段交换。同一种子和选项会生成相同置换。" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsClassEditor}" Spacing="12">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="职业"/><local:ModSearchPicker ItemsSource="{Binding ClassChoices}" SelectedItem="{Binding SelectedClass, Mode=TwoWay}"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="AP"/><NumericUpDown Value="{Binding ValueA}" Minimum="1" Maximum="4"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="PP"/><NumericUpDown Value="{Binding ValueB}" Minimum="1" Maximum="4"/></StackPanel>
                    </Grid>
                    <TextBlock FontWeight="SemiBold" Text="每级成长率（100 为基准）"/>
                    <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                      <StackPanel Spacing="4"><TextBlock Classes="option-title" Text="生命"/><NumericUpDown Value="{Binding ValueD}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="option-title" Text="物攻"/><NumericUpDown Value="{Binding ValueE}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Classes="option-title" Text="物防"/><NumericUpDown Value="{Binding ValueF}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Column="3" Spacing="4"><TextBlock Classes="option-title" Text="魔攻"/><NumericUpDown Value="{Binding ValueG}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Column="4" Spacing="4"><TextBlock Classes="option-title" Text="魔防"/><NumericUpDown Value="{Binding ValueH}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Row="1" Spacing="4"><TextBlock Classes="option-title" Text="命中"/><NumericUpDown Value="{Binding ValueI}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Classes="option-title" Text="闪避"/><NumericUpDown Value="{Binding ValueJ}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Classes="option-title" Text="暴击"/><NumericUpDown Value="{Binding ValueK}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="3" Spacing="4"><TextBlock Classes="option-title" Text="格挡"/><NumericUpDown Value="{Binding ValueL}" Minimum="0" Maximum="1000"/></StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="4" Spacing="4"><TextBlock Classes="option-title" Text="速度"/><NumericUpDown Value="{Binding ValueM}" Minimum="0" Maximum="1000"/></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="主动技能"/>
                        <ItemsControl ItemsSource="{Binding ActiveSkills}">
                          <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="70,*,82" ColumnSpacing="6" Margin="0,0,0,6"><TextBlock Classes="option-title" Text="{Binding SlotName}" VerticalAlignment="Center"/><local:ModSearchPicker Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"/><NumericUpDown Grid.Column="2" Value="{Binding Level}" Minimum="1" Maximum="99" IsEnabled="{Binding CanEditLevel}" ToolTip.Tip="习得等级；第一项固定 1 级"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="被动技能"/>
                        <ItemsControl ItemsSource="{Binding PassiveSkills}">
                          <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="70,*,82" ColumnSpacing="6" Margin="0,0,0,6"><TextBlock Classes="option-title" Text="{Binding SlotName}" VerticalAlignment="Center"/><local:ModSearchPicker Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"/><NumericUpDown Grid.Column="2" Value="{Binding Level}" Minimum="1" Maximum="99" IsEnabled="{Binding CanEditLevel}" ToolTip.Tip="习得等级；第一项固定 1 级"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Text="技能下拉按主动/被动分开；第一项固定 1 级，后续技能可设置习得等级。更换为职业无法播放其动画的技能可能显示异常。" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsFortEditor}" Spacing="8">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="地图地点"/><local:ModSearchPicker ItemsSource="{Binding FortLocations}" SelectedItem="{Binding SelectedFortLocation, Mode=TwoWay}"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="招募位置"/><ComboBox ItemsSource="{Binding FortRecordsAtLocation}" SelectedItem="{Binding SelectedFortRecord, Mode=TwoWay}" MaxDropDownHeight="420"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DetailDisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="可招募职业"/><local:ModSearchPicker ItemsSource="{Binding ClassChoices}" SelectedItem="{Binding SelectedFortClass, Mode=TwoWay}"/></StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Text="按游戏中的据点名称选择招募位置；选择后载入该位置的原版职业。仅修改职业，不覆盖亚洲版额外字段。" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsMineEditor}" Spacing="12">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="地图地点"/><ComboBox ItemsSource="{Binding MineLocations}" SelectedItem="{Binding SelectedMineLocation, Mode=TwoWay}" MaxDropDownHeight="420"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="原版掉落"/><ComboBox ItemsSource="{Binding MineRecordsAtLocation}" SelectedItem="{Binding SelectedMineRecord, Mode=TwoWay}" MaxDropDownHeight="420"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DetailDisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="修改为"/><local:ModSearchPicker ItemsSource="{Binding ItemChoices}" SelectedItem="{Binding SelectedMineItem, Mode=TwoWay}"/></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="掉落权重"/><NumericUpDown Value="{Binding ValueB}" Minimum="0" Maximum="1000000"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="挖掘目标"/><NumericUpDown Value="{Binding ValueC}" Minimum="0" Maximum="1000000"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="单局上限"/><NumericUpDown Value="{Binding ValueD}" Minimum="1" Maximum="999999"/></StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Text="掉落权重是同地区各槽之间的相对概率；挖掘目标越高越难在限时内挖出；单局上限限制一次采矿最多取得数量。" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsShopEditor}" Spacing="12">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="地图地点"/><ComboBox ItemsSource="{Binding ShopLocations}" SelectedItem="{Binding SelectedShopLocation, Mode=TwoWay}" MaxDropDownHeight="420"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="原版商品"/><ComboBox ItemsSource="{Binding ShopRecordsAtLocation}" SelectedItem="{Binding SelectedShopRecord, Mode=TwoWay}" MaxDropDownHeight="420"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DetailDisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="修改为"/><local:ModSearchPicker ItemsSource="{Binding ItemChoices}" SelectedItem="{Binding SelectedShopItem, Mode=TwoWay}"/></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="库存（-1 为无限）"/><NumericUpDown Value="{Binding ValueB}" Minimum="-1" Maximum="9999"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="金币买价"/><NumericUpDown Value="{Binding ValueC}" Minimum="0" Maximum="65535"/></StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Text="先选地图地点，再选该武具店的商品；带“共享库存”的条目会同步影响引用同一库存的城镇。金币买价按物品全局共享，卖价自动设为买价的 10%。" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsSixMemberUnits}" Spacing="5">
                    <TextBlock Classes="option-title" Text="第五人扩充到第六人的荣誉费用"/><NumericUpDown Value="{Binding ValueA}" Minimum="0" Maximum="999999"/>
                    <TextBlock Classes="caption" Text="并非默认开启：只有打开此开关并导出安装补丁后，S 级声望的小队才可扩充到六人。" TextWrapping="Wrap"/>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsTypeMatchups}" Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5"><TextBlock Classes="option-title" Text="骑兵对步兵"/><ComboBox ItemsSource="{Binding MatchupValues}" SelectedItem="{Binding ValueD}"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="option-title" Text="弓兵对飞行"/><ComboBox ItemsSource="{Binding MatchupValues}" SelectedItem="{Binding ValueE}"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="5"><TextBlock Classes="option-title" Text="飞龙/狮鹫对骑兵"/><ComboBox ItemsSource="{Binding MatchupValues}" SelectedItem="{Binding ValueF}"/></StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Text="三项倍率作用于对应兵种的每一次攻击，与技能自身的类型加成相乘。例如骑兵对步兵设为 1 表示取消固有双倍克制。" TextWrapping="Wrap"/>
                  </StackPanel>

                  <TextBlock IsVisible="{Binding HasNoOptions}" Classes="caption" Text="此模块本身只有启用或停用，没有额外参数。"/>
	                </StackPanel>
	                <Border IsVisible="{Binding ShowContentSeparator}" Height="1" Background="{StaticResource BorderBrush}" Margin="0,18" />
	                </StackPanel>
	                    </DataTemplate>
	                  </ItemsControl.ItemTemplate>
	                </ItemsControl>
              </ScrollViewer>
			  <Grid Grid.Column="1" IsVisible="{Binding $parent[Window].DataContext.IsTextModWorkspace}" DataContext="{Binding TextEditor}" RowDefinitions="Auto,Auto,*">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="18,14">
			  <StackPanel Spacing="3">
				<TextBlock Classes="section-title" Text="文本编辑器" />
				<TextBlock Classes="caption" Text="基于所选语言 CPK 的原始 FMS 按索引修改；不会改动源归档" />
			  </StackPanel>
			  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<Button Classes="compact" Content="选择 CPK 工具" Command="{Binding ChooseToolCommand}" />
				<Button Classes="primary" Content="载入 CPK 副本" Command="{Binding OpenCpkCommand}" />
			  </StackPanel>
			</Grid>

			<Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="18,10">
			  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
				<StackPanel Spacing="2">
				  <TextBlock Text="{Binding SourceSummary}" FontWeight="SemiBold" />
				  <TextBlock Classes="caption" Text="{Binding SourceCpkPath}" TextTrimming="CharacterEllipsis" />
				  <TextBlock Classes="caption" Text="{Binding ToolSummary}" TextTrimming="CharacterEllipsis" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				  <TextBlock Classes="caption option-title" Text="文本语言" VerticalAlignment="Center" />
				  <ComboBox Width="122" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
					<ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
				  </ComboBox>
				  <TextBlock Classes="caption" Text="{Binding ExpectedCpkText}" VerticalAlignment="Center" />
				</StackPanel>
			  </Grid>
			</Border>

			<Grid Grid.Row="2" ColumnDefinitions="230,360,*">
			  <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
					   BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
				<ListBox.ItemTemplate>
				  <DataTemplate>
					<StackPanel Spacing="3">
					  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
					  <TextBlock Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap" />
					</StackPanel>
				  </DataTemplate>
				</ListBox.ItemTemplate>
			  </ListBox>

			  <Grid Grid.Column="1" RowDefinitions="Auto,*">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12">
				  <TextBox PlaceholderText="输入索引或文本" Text="{Binding SearchText, Mode=TwoWay}" />
				  <Button Grid.Column="1" Classes="compact" Content="搜索" Command="{Binding SearchCommand}" />
				</Grid>
				<ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
				  <ListBox.ItemTemplate>
					<DataTemplate>
					  <Grid ColumnDefinitions="62,*" ColumnSpacing="8">
						<TextBlock Text="{Binding Index}" Foreground="{StaticResource AccentBrush}" />
						<StackPanel Grid.Column="1" Spacing="2">
						  <TextBlock Text="{Binding Text}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
						  <TextBlock Classes="caption" Text="{Binding StateText}" />
						</StackPanel>
					  </Grid>
					</DataTemplate>
				  </ListBox.ItemTemplate>
				</ListBox>
			  </Grid>

			  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True" Padding="0,0,12,0">
				<StackPanel Margin="18" Spacing="10">
				  <TextBlock Classes="section-title" Text="{Binding SelectedEntry.Index, StringFormat='索引 {0}'}" />
				  <TextBlock Text="原文" FontWeight="SemiBold" />
				  <Border Background="#F3F4F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" MinHeight="92">
					<TextBlock Text="{Binding SelectedEntry.OriginalText}" TextWrapping="Wrap" />
				  </Border>
				  <TextBlock Text="修改后文本" FontWeight="SemiBold" />
				  <TextBox Text="{Binding SelectedEntry.Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" />
				  <TextBlock Classes="caption" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
				</StackPanel>
			  </ScrollViewer>
			</Grid>

			  </Grid>
	        </Grid>
			</Border>
			</Border>
		  </TabItem>
	</TabControl>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding IsSaveWorkspace}">
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentFileName}" FontWeight="SemiBold" />
            <TextBlock Classes="caption" Text="{Binding FileLocation}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="header" Content="打开存档" Command="{Binding OpenFileCommand}" />
            <Button Classes="compact" Content="存档另存为" Command="{Binding SaveAsFileCommand}" IsEnabled="{Binding IsSaveLoaded}" />
            <Button Classes="primary" Content="保存存档" Command="{Binding SaveFileCommand}" IsEnabled="{Binding IsSaveLoaded}" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding IsGameplayModWorkspace}">
          <TextBlock Text="MOD 制作" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="primary" Content="导出 MOD 包" Command="{Binding ExportModPackageCommand}" IsEnabled="{Binding CanExportMods}" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding IsTextModWorkspace}">
          <TextBlock Text="文本 MOD" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="primary" Content="导出文本 MOD 包" Command="{Binding TextEditor.ExportCommand}" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="caption" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ContextStatusMessage}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
