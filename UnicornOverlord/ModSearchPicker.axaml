<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnicornOverlord.ModSearchPicker">
  <Grid ColumnDefinitions="*,150" ColumnSpacing="6">
    <ComboBox x:Name="Choices" MaxDropDownHeight="360"/>
    <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索名称或 ID" TextChanged="OnSearchTextChanged"/>
  </Grid>
</UserControl>
